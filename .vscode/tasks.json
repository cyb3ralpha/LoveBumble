{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Realtime Server",
      "type": "shell",
      "command": "C:/Users/ab587/AppData/Local/Microsoft/WindowsApps/python3.11.exe -m realtime.server",
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Start Frontend Server",
      "type": "shell",
      "command": "C:/Users/ab587/AppData/Local/Microsoft/WindowsApps/python3.11.exe -m http.server 8000",
      "options": {"cwd": "${workspaceFolder}/frontend"},
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Start PHP + MariaDB (Docker)",
      "type": "shell",
      "command": "docker-compose up -d",
      "presentation": {"reveal": "always", "panel": "shared"}
    },
    {
      "label": "Stop PHP + MariaDB (Docker)",
      "type": "shell",
      "command": "docker-compose down",
      "presentation": {"reveal": "always", "panel": "shared"}
    }
  ]
}
